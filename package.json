{
  "name": "dsh-nexus",
  "version": "0.2.0",
  "private": true,
  "description": "Nexus Realtime supervisor for DeepSeek Harness",
  "type": "module",
  "exports": { ".": "./dist/index.js", "./client": "./client.js", "./typert": "./typert.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["dist", "client.js", "typert.js", "cordis.patch.yml", "locale", "icon.svg"],
  "scripts": { "build": "tsc", "typecheck": "tsc --noEmit", "test": "node --test tests/*.test.mjs" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-api-gateway", "@deepseek-ai/dsh-client-ui-conversation"] } },
  "peerDependencies": { "@deepseek-ai/schemastery": "3.18.4", "@deepseek-ai/cordis": "4.0.4", "@deepseek-ai/dsh-agent": "0.2.0-rc.2", "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2", "@deepseek-ai/dsh-tools": "0.2.0-rc.2", "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2", "@deepseek-ai/dsh-util-values": "0.2.0-rc.2", "@deepseek-ai/dsh-session": "0.2.0-rc.2", "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2", "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2", "@deepseek-ai/dsh-scope": "0.2.0-rc.2", "@deepseek-ai/dsh-llm": "0.2.0-rc.2", "@deepseek-ai/dsh-credentials": "0.2.0-rc.2", "@deepseek-ai/dsh-workspace": "0.2.0-rc.2", "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2", "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2" },
  "dependencies": { "ws": "8.22.0" },
  "devDependencies": { "@deepseek-ai/dsh": "0.2.0-rc.2", "@types/node": "26.6.4", "@types/ws": "8.18.2", "typescript": "5.9.3", "playwright": "1.64.0" },
  "engines": { "node": "^22.19.0 || >=24.0.0" }
}
